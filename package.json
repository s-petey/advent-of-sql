    "effect": "^3.19.14",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.63.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.8",
    "effect-solutions": "^0.4.13",
