{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    // "target": "ESNext",
    // "module": "Preserve",
    // "moduleDetection": "force",
    // "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    // "moduleResolution": "bundler",
    // "allowImportingTsExtensions": true,
    // "verbatimModuleSyntax": true,
    // "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noPropertyAccessFromIndexSignature": false,

    // Effect settings
    // Build perf
    "incremental": true,
    "composite": true,
    // Module system
    // "target": "ES2022",
    // "module": "NodeNext",
    // "moduleDetection": "force",
    // // However for bundled apps (vite, webpack, esbuild, rollup, etc)
    // "module": "preserve",
    // "moduleResolution": "bundler",
    // "noEmit": true
    // // And for Libraries & Node.js Apps (Ts is compiler) -- cli tools
    "module": "NodeNext",

    // Import handling
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    // Type safety
    // "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    // "noImplicitOverride": true,
    "noUnusedParameters": false,
    // Development
    "declarationMap": true,
    "sourceMap": true,
    // "skipLibCheck": true,
    // Additional library settings
    "declaration": true,
    // "composite": true, // monorepos only
    // "declarationMap": true, // monorepos only

    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}
